# Neon Postgres connection string (use the pooled one, host contains "-pooler")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# The single shared secret the frontend sends in the X-Access-Key header
APP_ACCESS_KEY=choose-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Optional: leave unset to disable Sentry entirely (no-op, no account needed)
SENTRY_DSN=
